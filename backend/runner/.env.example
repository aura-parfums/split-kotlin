# Generate a long random token before starting the runner.
RUNNER_TOKEN=replace-with-a-long-random-secret
RUNNER_PORT=4317
RUNNER_HOST=127.0.0.1
# Set this to the exact origin where the Next.js workspace runs.
WORKSPACE_ORIGIN=http://localhost:3000
# Optional Android SDK path. ANDROID_HOME / ANDROID_SDK_ROOT are also detected.
ANDROID_HOME=
